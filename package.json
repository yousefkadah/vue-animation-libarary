{
  "name": "@yousefkadah/vue-magic-ui",
  "version": "2.0.1",
  "description": "70+ free and open-source animated components for Vue 3, built with Tailwind CSS and Motion. Copy-paste them with the shadcn-vue CLI or install from npm.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yousefkadah/vue-animation-libarary.git"
  },
  "homepage": "https://yousefkadah.github.io/vue-animation-libarary/",
  "bugs": {
    "url": "https://github.com/yousefkadah/vue-animation-libarary/issues"
  },
  "scripts": {
    "dev": "npm run registry:meta && vite",
    "build": "npm run registry && npm run build:site && npm run build:lib",
    "build:site": "vite build",
    "build:lib": "vite build --mode lib",
    "registry": "node scripts/build-registry.mjs --strict && shadcn-vue build --output public/r",
    "registry:meta": "node scripts/build-registry.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "npm run registry && npm run build:site && gh-pages -d dist-site --dotfiles",
    "prepublishOnly": "node scripts/build-registry.mjs --strict && npm run typecheck && npm test && npm run build:lib"
  },
  "keywords": [
    "vue",
    "vue3",
    "nuxt",
    "animation",
    "animated-components",
    "motion",
    "motion-v",
    "tailwindcss",
    "shadcn-vue",
    "magic-ui",
    "ui-library",
    "components",
    "design-engineering"
  ],
  "author": "Yousef Kadah",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@lucide/vue": "^1.53.0",
    "@vueuse/core": "^15.0.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cobe": "^2.0.1",
    "motion-v": "^2.6.0",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/language-core": "^3.3.12",
    "@vue/test-utils": "^2.5.1",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "shadcn-vue": "^2.8.2",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4",
    "vue-tsc": "^3.3.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
