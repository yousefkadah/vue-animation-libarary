{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "animated-gradient-text-demo",
  "title": "Animated Gradient Text — Announcement pill",
  "dependencies": [
    "@lucide/vue"
  ],
  "registryDependencies": [
    "https://yousefkadah.github.io/vue-animation-libarary/r/animated-gradient-text.json"
