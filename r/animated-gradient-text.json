{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "animated-gradient-text",
  "title": "Animated Gradient Text",
  "description": "An animated gradient background which transitions between colors for text.",
  "registryDependencies": [
    "utils"
  ],
  "files": [
    {
      "path": "src/registry/ui/animated-gradient-text/AnimatedGradientText.vue",
      "content": "<script setup lang=\"ts\">\nimport type { HTMLAttributes } from 'vue'\nimport { cn } from '@/lib/utils'\n\nexport interface AnimatedGradientTextProps {\n  class?: HTMLAttributes['class']\n  /** Animation speed multiplier; widens the gradient so it travels further per loop. */\n  speed?: number\n  /** Gradient start (and end) colour. */\n  colorFrom?: string\n  /** Gradient middle colour. */\n  colorTo?: string\n}\n\nconst props = withDefaults(defineProps<AnimatedGradientTextProps>(), {\n  speed: 1,\n  colorFrom: '#ffaa40',\n  colorTo: '#9c40ff',\n})\n</script>\n\n<template>\n  <span\n    :style=\"{ '--bg-size': `${props.speed * 300}%`, '--color-from': props.colorFrom, '--color-to': props.colorTo }\"\n    :class=\"\n      cn(\n        'animate-gradient inline bg-linear-to-r from-(--color-from) via-(--color-to) to-(--color-from) bg-size-[var(--bg-size)_100%] bg-clip-text text-transparent motion-reduce:animate-none',\n        props.class,\n      )\n    \"\n  >\n    <slot />\n  </span>\n</template>\n",
      "type": "registry:ui"
    },
    {
      "path": "src/registry/ui/animated-gradient-text/index.ts",
      "content": "export { default as AnimatedGradientText } from './AnimatedGradientText.vue'\nexport type { AnimatedGradientTextProps } from './AnimatedGradientText.vue'\n",
      "type": "registry:ui"
    }
  ],
  "cssVars": {
    "theme": {
      "animate-gradient": "gradient 8s linear infinite"
    }
  },
  "css": {
    "@keyframes gradient": {
      "to": {
        "background-position": "var(--bg-size, 300%) 0"
      }
    }
  },
  "categories": [
    "text-animations"
  ],
  "type": "registry:ui"
}
