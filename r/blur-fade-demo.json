{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "blur-fade-demo",
  "title": "Blur Fade — Image gallery",
  "registryDependencies": [
    "https://yousefkadah.github.io/vue-animation-libarary/r/blur-fade.json"
  ],
  "files": [
    {
      "path": "src/registry/examples/blur-fade-demo.vue",
      "content": "<script setup lang=\"ts\">\nimport { BlurFade } from '@/components/ui/blur-fade'\n\nconst images = Array.from({ length: 9 }, (_, index) => {\n  const landscape = index % 2 === 0\n  return `https://picsum.photos/seed/${index + 1}/${landscape ? 800 : 600}/${landscape ? 600 : 800}`\n})\n</script>\n\n<template>\n  <section class=\"w-full columns-2 gap-4 sm:columns-3\">\n    <BlurFade v-for=\"(image, index) in images\" :key=\"image\" :delay=\"0.25 + index * 0.05\" in-view>\n      <img class=\"mb-4 size-full rounded-lg object-contain\" :src=\"image\" :alt=\"`Random stock image ${index + 1}`\" />\n    </BlurFade>\n  </section>\n</template>\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
