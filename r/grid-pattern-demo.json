      "path": "src/registry/examples/grid-pattern-demo.vue",
      "content": "<script setup lang=\"ts\">\nimport { GridPattern } from '@/components/ui/grid-pattern'\n\nconst squares: Array<[number, number]> = [\n  [4, 4],\n  [5, 1],\n  [8, 2],\n  [5, 3],\n  [5, 5],\n  [10, 10],\n  [12, 15],\n  [15, 10],\n  [10, 15],\n  [6, 7],\n  [11, 6],\n  [13, 9],\n]\n</script>\n\n<template>\n  <div class=\"relative flex h-[400px] w-full flex-col items-center justify-center overflow-hidden rounded-lg border bg-background\">\n    <GridPattern\n      :squares=\"squares\"\n      class=\"inset-x-0 inset-y-[-30%] h-[200%] skew-y-12 [mask-image:radial-gradient(400px_circle_at_center,white,transparent)]\"\n    />\n  </div>\n</template>\n",
      "type": "registry:example"
    }
