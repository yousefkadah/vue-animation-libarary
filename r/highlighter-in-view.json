{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "highlighter-in-view",
  "title": "Highlighter — Draw when in view",
  "registryDependencies": [
    "https://yousefkadah.github.io/vue-animation-libarary/r/highlighter.json"
