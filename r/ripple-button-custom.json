{
  "$schema": "https://shadcn-vue.com/schema/registry-item.json",
  "name": "ripple-button-custom",
  "title": "Ripple Button — Custom colour and speed",
  "registryDependencies": [
    "https://yousefkadah.github.io/vue-animation-libarary/r/ripple-button.json"
  ],
  "files": [
    {
      "path": "src/registry/examples/ripple-button-custom.vue",
      "content": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\nimport { RippleButton } from '@/components/ui/ripple-button'\n\nconst clicks = ref(0)\n</script>\n\n<template>\n  <div class=\"flex flex-col items-center gap-3\">\n    <RippleButton\n      ripple-color=\"#a855f7\"\n      duration=\"1s\"\n      class=\"rounded-full border-violet-500/40 px-6 py-2.5 font-medium text-violet-700 dark:text-violet-300\"\n      @click=\"clicks++\"\n    >\n      Slow purple ripple\n    </RippleButton>\n    <p class=\"text-sm text-muted-foreground\" aria-live=\"polite\">Clicked {{ clicks }} {{ clicks === 1 ? 'time' : 'times' }}</p>\n  </div>\n</template>\n",
      "type": "registry:example"
    }
  ],
  "type": "registry:example"
}
