{
  "name": "backlight",
  "title": "Backlight",
  "description": "A backlight glow effect for videos, images, and SVGs.",
  "category": "special-effects",
  "exports": ["Backlight"],
  "dependencies": [],
  "usage": "<script setup lang=\"ts\">\nimport { Backlight } from '@/components/ui/backlight'\n</script>\n\n<template>\n  <Backlight :blur=\"20\">\n    <img src=\"/cover.jpg\" alt=\"\" class=\"rounded-xl\" />\n  </Backlight>\n</template>",
  "examples": [
    { "name": "backlight-demo", "title": "Image" },
    { "name": "backlight-video", "title": "Video" },
    { "name": "backlight-svg", "title": "SVG" }
  ],
  "api": [
    {
      "name": "Backlight",
      "props": [
        { "name": "class", "type": "string", "description": "Classes for the wrapper." },
        { "name": "blur", "type": "number", "default": "20", "description": "Blur radius of the glow (SVG `stdDeviation`)." }
      ],
      "slots": [{ "name": "default", "description": "The video, image or SVG that casts the glow. A blurred, saturated copy is drawn behind it by an SVG filter." }]
    }
  ]
}
